###############################################################################
# Application
###############################################################################
APP_NAME="مسنن"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

###############################################################################
# Clinic identity (printed on receipts, prescriptions, SMS)
###############################################################################
CLINIC_NAME="کلینیک دندانپزشکی"
CLINIC_PHONE=""
CLINIC_ADDRESS=""
CLINIC_CURRENCY=IRR
CLINIC_CURRENCY_DISPLAY=rial
CLINIC_PATIENT_CODE_START=10000

###############################################################################
# Docker (compose reads these)
###############################################################################
APP_PORT=8080
# NOTE: the app image runs as www-data (uid 33). Before the first `up`, give
# it the two directories it writes to:
#   sudo chown -R 33:33 storage bootstrap/cache
VITE_PORT=5173
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

APP_IMAGE=serversideup/php:8.4-fpm-nginx
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
NODE_IMAGE=node:22-alpine

###############################################################################
# Database (PostgreSQL)
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mosannen
DB_USERNAME=mosannen
DB_PASSWORD=change-me-in-production

###############################################################################
# Legacy SQL Server — used ONLY by `php artisan legacy:import` (read-only)
###############################################################################
LEGACY_DB_HOST=192.168.1.10
LEGACY_DB_PORT=1433
LEGACY_DB_DATABASE=azarbazak
LEGACY_DB_USERNAME=sa
LEGACY_DB_PASSWORD=
LEGACY_DB_ENCRYPT=no
LEGACY_DB_TRUST_CERT=true
# Where the legacy \\server\AppIMG\ share is mounted while importing images
LEGACY_IMAGES_PATH=/legacy-images

###############################################################################
# Session / cache / queue
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

###############################################################################
# Radiography image storage
#   local -> on-prem folder (recommended to start)
#   s3    -> MinIO in Docker, or any S3-compatible cloud
###############################################################################
IMAGES_DISK_DRIVER=local
IMAGES_DISK_ROOT=/var/www/html/storage/app/images
IMAGES_MAX_UPLOAD_MB=25

IMAGES_S3_KEY=mosannen
IMAGES_S3_SECRET=change-me-in-production
IMAGES_S3_REGION=us-east-1
IMAGES_S3_BUCKET=radiography
IMAGES_S3_ENDPOINT=http://minio:9000
IMAGES_S3_PATH_STYLE=true

###############################################################################
# SMS  (log | kavenegar | smsir)
###############################################################################
SMS_DRIVER=log
SMS_SENDER=
KAVENEGAR_API_KEY=
SMSIR_API_KEY=
SMS_ON_TREATMENT=true
SMS_ON_PAYMENT=true
SMS_ON_APPOINTMENT=true

###############################################################################
# Logging / mail
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

MAIL_MAILER=log
